# ── Required ──────────────────────────────────────────────────────────────
# Postgres (Neon in prod, local pg for dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/bvauto"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5433/bvauto"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/bvauto_shadow"

# Auth.js v5 — generate with: npx auth secret
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Required in production (Vercel) or Auth.js throws UntrustedHost
AUTH_TRUST_HOST="true"

# ── Features (app runs without them; the integration is disabled) ──────────
# AI diagnostics / estimates (Anthropic Claude)
ANTHROPIC_API_KEY=""

# SMS via Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Payments via Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email via Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Web push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# File uploads via Vercel Blob
BLOB_READ_WRITE_TOKEN=""

# ── Optional ──────────────────────────────────────────────────────────────
# CRON_SECRET protects /api/cron/* — set it and send Authorization: Bearer <secret>
CRON_SECRET=""
# Invite code required on /register
STAFF_INVITE_CODE=""
# Phone that receives new-booking SMS alerts
SHOP_NOTIFY_PHONE=""
# Admin email used by the seed script
ADMIN_EMAIL="admin@bvauto.com"
# Google review link shown to customers
GOOGLE_REVIEW_URL=""
# Carfax integration
CARFAX_API_KEY=""
CARFAX_API_URL=""
# QuickBooks OAuth
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
# Sentry error tracking
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
