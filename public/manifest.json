    {
      "name": "New Job",
      "short_name": "New Job",
      "description": "Create a new repair job",
      "url": "/jobs/new",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "My Jobs",
      "short_name": "My Jobs",
      "description": "Technician job view",
      "url": "/tech",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Shop Board",
      "short_name": "Board",
      "description": "Live shop board",
      "url": "/shop-board",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "categories": ["automotive", "business", "productivity"],
  "lang": "en-US",
  "dir": "ltr",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
